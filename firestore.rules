rules_version = '2';
// Cypress Street leaderboard rules.
// Anyone can read the board and add a score; nobody can edit or delete scores.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'deliveries', 'combo', 'avatar', 'pid', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.score is int && request.resource.data.score > 0 && request.resource.data.score <= 50000
        && request.resource.data.deliveries is int && request.resource.data.combo is int
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 300
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 40
        && request.resource.data.at is timestamp;
      allow update, delete: if false;
    }
  }
}
